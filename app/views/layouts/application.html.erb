<!DOCTYPE html>
<html class="h-full" data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "WhatsApp Agent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full">
    <% if user_signed_in? %>
      <header class="border-b border-gray-200 bg-surface">
        <div class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-4 sm:px-6">
          <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-on-primary"><%= icon :inbox, size: 16 %></span>
            <span class="font-semibold tracking-tight">WhatsApp Agent</span>
          <% end %>

          <nav class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto">
            <%= nav_link "Dashboard", root_path, active: controller_name == "dashboard" %>
            <%= nav_link "Inbox", conversations_path, active: controller_name.in?(%w[conversations messages]), count: Conversation.human_active.count %>
            <%= nav_link "Tickets", tickets_path, active: controller_name == "tickets" %>
            <%= nav_link "Templates", message_templates_path, active: controller_name == "message_templates" %>
            <%= nav_link "Contacts", contacts_path, active: controller_name == "contacts" %>
            <% if current_user.admin? %>
              <%= nav_link "Team", admin_users_path, active: controller_path == "admin/users" %>
            <% end %>
          </nav>

          <%= form_with url: contacts_path, method: :get, class: "relative hidden lg:block" do |f| %>
            <span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-gray-400"><%= icon :search, size: 15 %></span>
            <%= f.search_field :q, value: (params[:q] if controller_name == "contacts"), placeholder: "Search contacts…", class: "form-control w-52 py-1.5 pl-8 text-[13px]" %>
          <% end %>

          <button type="button" data-controller="theme" data-action="theme#toggle" class="btn h-8 w-8 shrink-0 p-0" title="Switch light / dark mode" aria-label="Switch light or dark mode">
            <span class="hidden [[data-theme=dark]_&]:inline"><%= icon :sun, size: 16 %></span>
            <span class="[[data-theme=dark]_&]:hidden"><%= icon :moon, size: 16 %></span>
          </button>

          <details class="relative shrink-0">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-1.5 py-1 hover:bg-gray-50">
              <span class="avatar h-7 w-7 text-xs"><%= current_user.initials %></span>
              <span class="hidden text-sm font-medium sm:block"><%= current_user.name %></span>
            </summary>
            <div class="card absolute right-0 z-20 mt-2 w-56 py-1 text-sm shadow-lg">
              <div class="border-b border-gray-100 px-4 py-2">
                <div class="font-medium"><%= current_user.name %></div>
                <div class="text-xs text-gray-500"><%= current_user.email %> · <%= current_user.role.humanize %></div>
              </div>
              <%= button_to destroy_user_session_path, method: :delete, class: "flex w-full items-center gap-2 px-4 py-2 text-left hover:bg-gray-50" do %>
                <%= icon :logout, size: 16 %> Sign out
              <% end %>
            </div>
          </details>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% else %>
      <main class="mx-auto max-w-sm px-4 py-16">
        <div class="mb-8 flex items-center justify-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-md bg-primary text-on-primary"><%= icon :inbox, size: 20 %></span>
          <span class="text-xl font-semibold tracking-tight">WhatsApp Agent</span>
        </div>
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
