<% content_for :title, "Reset password" %>

<% content_for :auth_aside do %>
  <h1 class="text-4xl font-extrabold leading-tight tracking-tight">Locked out? It happens.</h1>
  <p class="mt-4 max-w-md text-[15px] leading-relaxed text-white/85">We'll email you a link to choose a new password. The AI agent keeps answering customers in the meantime.</p>
<% end %>

<h2 class="text-2xl font-bold tracking-tight">Forgot password</h2>
<p class="mt-1 text-sm text-gray-500">Enter your work email and we'll send you a reset link.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
  <%= render "shared/auth_errors", resource: resource %>
  <div>
    <%= f.label :email, "Work email", class: "form-label" %>
    <div class="relative">
      <span class="input-icon"><%= icon :mail, size: 16 %></span>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@company.com", class: "form-control pl-9" %>
    </div>
  </div>
  <%= f.submit "Send reset link", class: "btn btn-primary w-full py-2.5" %>
<% end %>

<p class="mt-8 text-center text-sm text-gray-500"><%= link_to "Back to sign in", new_session_path(resource_name), class: "link font-semibold" %></p>
