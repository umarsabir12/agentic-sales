<%# A password input with a lock icon and a show/hide button. %>
<div class="relative" data-controller="password-visibility">
  <span class="input-icon"><%= icon :lock, size: 16 %></span>
  <%= f.password_field field, autocomplete: autocomplete, required: true, placeholder: placeholder,
        class: "form-control pl-9 pr-10", data: { password_visibility_target: "input" }.merge(local_assigns.fetch(:data, {})) %>
  <button type="button" class="absolute inset-y-0 right-0 flex w-10 cursor-pointer items-center justify-center text-gray-400 hover:text-ink"
          data-action="password-visibility#toggle" aria-label="Show password">
    <span data-password-visibility-target="show"><%= icon :eye, size: 16 %></span>
    <span data-password-visibility-target="hide" hidden><%= icon :eye_off, size: 16 %></span>
  </button>
</div>
