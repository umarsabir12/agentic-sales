<% content_for :title, "Sign in" %>

<% content_for :auth_aside do %>
  <h1 class="text-4xl font-extrabold leading-tight tracking-tight">Every WhatsApp lead, answered.</h1>
  <p class="mt-4 max-w-md text-[15px] leading-relaxed text-white/85">The AI agent replies to customers in seconds and hands real buying conversations to your sales team.</p>

  <%= render "devise/shared/phone_illustration" %>
<% end %>

<h2 class="text-2xl font-bold tracking-tight">Sign in</h2>
<p class="mt-1 text-sm text-gray-500">Welcome back. Sign in to your sales portal.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
  <div>
    <%= f.label :email, "Work email", class: "form-label" %>
    <div class="relative">
      <span class="input-icon"><%= icon :mail, size: 16 %></span>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@company.com", class: "form-control pl-9" %>
    </div>
  </div>

  <div>
    <div class="flex items-center justify-between">
      <%= f.label :password, class: "form-label" %>
      <%= link_to "Forgot password?", new_password_path(resource_name), class: "link mb-1.5 text-xs font-medium" %>
    </div>
    <%= render "devise/shared/password_field", f: f, field: :password, autocomplete: "current-password", placeholder: "Enter your password" %>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :remember_me, checked: true, class: "h-4 w-4 rounded border-gray-300 accent-[var(--color-primary)]" %> Keep me signed in
  </label>

  <%= f.submit "Sign in", class: "btn btn-primary w-full py-2.5" %>
<% end %>

<p class="mt-8 text-center text-sm text-gray-500">
  New to Tronsit Sales Agent? <%= link_to "Create an account", new_user_registration_path, class: "link font-semibold" %>
</p>
