<% content_for :title, "Team" %>

<%= render "shared/page_header", pretitle: "Admin", title: "Team" do %>
  <%= link_to new_admin_user_path, class: "btn btn-primary" do %><%= icon :plus, size: 16 %> Add member<% end %>
<% end %>

<section class="card overflow-x-auto">
  <table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <div class="flex items-center gap-3">
              <span class="avatar h-8 w-8 text-xs"><%= user.initials %></span>
              <span class="font-medium"><%= user.name %></span>
            </div>
          </td>
          <td class="text-gray-600"><%= user.email %></td>
          <td><%= user.role.humanize %></td>
          <td>
            <div class="flex justify-end gap-2">
              <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm" %>
              <% unless user == current_user %>
                <%= button_to "Remove", admin_user_path(user), method: :delete, form: { data: { turbo_confirm: "Remove #{user.name}?" } }, class: "btn btn-sm btn-danger" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
