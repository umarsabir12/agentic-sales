<div id="<%= dom_id(message) %>" class="flex <%= message.outbound? ? "justify-end" : "justify-start" %>">
  <div class="max-w-[75%] rounded-lg px-3.5 py-2 text-sm <%= message.outbound? ? "bg-primary text-on-primary" : "border border-gray-200 bg-surface" %>">
    <% unless message.sent_by_customer? %>
      <div class="mb-0.5 text-xs font-semibold opacity-80">
        <%= message.sent_by_ai? ? "AI agent" : message.user&.name || message.sender_type.humanize %><% if message.template? %> · template <%= message.template_name %><% end %>
      </div>
    <% end %>
    <p class="whitespace-pre-wrap"><%= message.body %></p>
    <div class="mt-1 text-right text-[10px] <%= message.outbound? ? "opacity-75" : "text-gray-400" %>">
      <%= message.created_at.strftime("%b %-d, %H:%M") %>
      <% if message.outbound? %> · <%= message.delivery_status %><% end %>
      <% if message.failed? && message.error_message.present? %>
        <div class="mt-0.5 font-medium">⚠ <%= message.error_message %></div>
      <% end %>
    </div>
  </div>
</div>
